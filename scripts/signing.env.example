# Signing settings for scripts/build-signed.sh. Copy to .signing.env in the repo root
# (git-ignored) and fill in. The file is sourced by bash, so $(...) works, e.g. to read a
# secret from the keychain instead of storing it here.

# The certificate to sign with, exactly as `security find-identity -v -p codesigning` prints
# it. Builds for other people need a "Developer ID Application" certificate.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"

# Notarization, option A (recommended): an App Store Connect API key (Users and Access →
# Integrations → App Store Connect API → Team Keys, role "Developer").
#APPLE_API_KEY="ABC123DEF4"                                   # Key ID
#APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"      # Issuer ID
#APPLE_API_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_ABC123DEF4.p8"

# Notarization, option B: your Apple ID with an app-specific password (account.apple.com →
# Sign-In and Security → App-Specific Passwords). Store the password in the keychain once:
#   security add-generic-password -a you@example.com -s slopslide-notarize -w
#APPLE_ID="you@example.com"
#APPLE_PASSWORD="$(security find-generic-password -a "$APPLE_ID" -s slopslide-notarize -w)"
#APPLE_TEAM_ID="TEAMID1234"

# Optional, for machines without the certificate in the keychain (like CI): the exported .p12
# as base64 (base64 -i cert.p12) and its export password.
#APPLE_CERTIFICATE="..."
#APPLE_CERTIFICATE_PASSWORD="..."
